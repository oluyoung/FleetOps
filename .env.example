# apps/api
PORT=4000
DATABASE_URL=postgres://fleetops:fleetops@localhost:5432/fleetops
LOG_LEVEL=info

# Realtime aggregation window (ADR-010)
TELEMETRY_PUSH_INTERVAL_MS=500

MQTT_URL=mqtt://localhost:1883
# MQTT is push-driven — this only controls how often the ingestion loop
# drains the adapter's buffered messages, not a fetch interval.
MQTT_POLL_INTERVAL_MS=1000

# OpenSky ingestion poll interval (bounded retry/backoff on failure, RFC-001)
OPENSKY_POLL_INTERVAL_MS=15000

# OpenSky OAuth2 client-credentials (https://opensky-network.org/my-opensky/account)
# Optional but strongly recommended: without these the adapter polls the
# anonymous endpoint, which rate-limits aggressively (frequent 429s).
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# Open-Meteo weather enrichment poll interval — forecast data updates
# hourly, so this defaults far slower than OPENSKY_POLL_INTERVAL_MS.
OPEN_METEO_POLL_INTERVAL_MS=600000

# CORS origin apps/api accepts requests from
WEB_ORIGIN=http://localhost:3000

# apps/web (must be prefixed NEXT_PUBLIC_ to reach the browser bundle)
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000/ws