// Fly.io app "fleetops-grafana-alloy" — scrapes fleetops-api's /metrics over
// Fly's private network and remote_writes to Grafana Cloud's hosted
// Prometheus (see DEPLOYMENT.md for account setup).
//
// Grafana Agent (the previous collector here) reached end-of-life on
// 2025-11-01; Grafana Alloy is its supported successor, so this is written
// in Alloy's River config syntax rather than the old agent.yaml YAML.

prometheus.scrape "fleetops_api" {
  targets = [
    // Reached over Fly's 6PN WireGuard mesh — fleetops-api and
    // fleetops-grafana-alloy must be apps in the same Fly org.
    // Fly app name is fleetops-api-muddy-frog-719 (auto-generated by
    // `fly launch`, "fleetops-api" was unavailable), so .internal DNS
    // resolves under that name, not "fleetops-api.internal".
    {"__address__" = "fleetops-api-muddy-frog-719.internal:4000"},
  ]
  scrape_interval = "15s"
  forward_to      = [prometheus.remote_write.grafana_cloud.receiver]
}

prometheus.remote_write "grafana_cloud" {
  endpoint {
    url = sys.env("GRAFANA_CLOUD_PROMETHEUS_URL")

    basic_auth {
      username = sys.env("GRAFANA_CLOUD_PROMETHEUS_USERNAME")
      password = sys.env("GRAFANA_CLOUD_API_KEY")
    }
  }
}
